        bars = ax.barh(
            d["SUBCLASE"],
            d["ha"],
            color=colores,)

        ax.set_xlabel("Superficie [ha]")
        ax.set_title(
            f"LCLU Uruguay · distribución por Subclase · {etiqueta}")
