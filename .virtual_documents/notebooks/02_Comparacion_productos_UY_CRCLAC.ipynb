def caja(x, y, w, h, texto, fc="#f7f7f7", ec="#555555", fontsize=11):
    p = FancyBboxPatch(
        (x, y), w, h,
        boxstyle="round,pad=0.03,rounding_size=0.12",
        linewidth=1.3, edgecolor=ec, facecolor=fc
    )
