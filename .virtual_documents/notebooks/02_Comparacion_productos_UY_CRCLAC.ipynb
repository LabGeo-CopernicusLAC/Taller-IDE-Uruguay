def transforms_equivalentes(t1, t2, atol=1e-9):
    """
    Compara dos transformaciones espaciales permitiendo
    pequeñas diferencias numéricas de punto flotante.
    """
    return np.allclose(
        np.array(t1)[:6],
        np.array(t2)[:6],
        rtol=0,
        atol=atol
    )


